COMPANY_NAME="April Coffee"
SITE_NAME="April Coffee"
# Storefront origin for post-checkout return_to (defaults to NEXT_PUBLIC_WEBSHOP_URL origin or localhost)
NEXT_PUBLIC_SITE_URL="https://april-coffee-roasters-headless.vercel.app/"
# DatoCMS Content Delivery API (read-only) token — April Coffee project
DATOCMS_API_TOKEN="bde362c7ca50be12aa42bd62497a6a"
# Optional: secret for POST /api/revalidate-dato (DatoCMS publish or cache-tag webhooks)
DATOCMS_WEBHOOK_SECRET="fa95194f8c328a04941a4808807cbcad"
# Required DatoCMS models (API keys): article, homepage, shop, range, product
# Homepage model (GraphQL: homepage): herotitle, herodescription, heroimage, featuredcontent (article slug).
# Header/footer links use app defaults until those fields exist in DatoCMS.
SHOPIFY_REVALIDATION_SECRET="YOUR_CHOSEN_SECRET_CHEESE"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="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"
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# Contact form (Resend) — emails go to Freshdesk support inbox
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="April Coffee <webshop@aprilcoffeeroastery.com>"
CONTACT_TO_EMAIL="support@aprilcoffeeroastery.freshdesk.com"
